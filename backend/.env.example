# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=HSE Intelligence API
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hse_db
DB_USER=root
DB_PASSWORD=secret
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs
LOG_MAX_BYTES=10485760       # 10 MB
LOG_BACKUP_COUNT=5

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
